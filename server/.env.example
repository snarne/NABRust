# Copy to server/.env (gitignored) and fill in. ./nab loads it automatically;
# anything already set in your shell wins.

# Battlemetrics personal access token (battlemetrics.com → Account → Developers).
# Read-only scopes are enough.
BATTLEMETRICS_TOKEN=

# Bearer token for the NABRust API. Change it before anything outside this
# machine can reach port 8787.
NABRUST_TOKEN=change-me

# Your own team's 64-bit Steam ids, comma-separated. Keeps the app from
# building teammate evidence about you and marks you as "us" everywhere.
NABRUST_TEAM=
NABRUST_TEAM_NAME=

# Optional: Steam Web API key (steamcommunity.com/dev/apikey) for profile
# age, VAC/game bans and Rust ownership in dossiers.
STEAM_API_KEY=

# Optional overrides
# PORT=8787
# NABRUST_DB=./nabrust.db
# NABRUST_DATA=./data
